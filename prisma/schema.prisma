generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  cliente
  medico
  backoffice
}

enum TipoOrganizacion {
  isapre
  compin
  empresa
  seguro
  subcontratista
}

enum EstadoCaso {
  recibido
  en_revision
  informe_en_validacion
  entregado
}

enum PrioridadCaso {
  normal
  urgente
}

enum EstadoSesion {
  agendada
  en_curso
  realizada
  incumplida_medico
  incumplida_evaluado
  reprogramada
  cancelada
}

enum FirmaProveedor {
  firmaweb
  sovos
  otro
}

enum CanalEnvio {
  whatsapp
  email
}

enum EstadoEnvio {
  enviado
  entregado
  leido
  fallido
}

enum EstadoPago {
  pendiente
  pagado
}

enum EstadoFactura {
  pendiente
  facturada
  pagada
}

model Usuario {
  id               String   @id @default(cuid())
  nombre           String
  email            String   @unique
  passwordHash     String
  rol              Rol
  activo           Boolean  @default(true)
  creadoEn         DateTime @default(now())
  organizacionId   String?
  especialidad     String?
  tarifaCasoClp    Int?
  ameliaProviderId Int?     @unique

  organizacion      Organizacion? @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  casosAsignados    Caso[]        @relation("CasoMedico")
  informesGenerados Informe[]     @relation("InformeGeneradoPor")
  descargas         LogDescarga[]
  logsRecibidos     LogEnvio[]    @relation("LogEnvioDestinatario")
  logsEnviados      LogEnvio[]    @relation("LogEnvioEnviadoPor")
  pagosMedico       PagoMedico[]

  @@index([email])
  @@index([organizacionId])
}

model Organizacion {
  id             String           @id @default(cuid())
  nombre         String
  tipo           TipoOrganizacion
  plazoSlaDias   Int
  creadoEn       DateTime         @default(now())
  tarifaCasoClp  Int?
  contactEmail   String?

  usuarios Usuario[]
  casos    Caso[]
  facturas FacturaOrganizacion[]
}

model Caso {
  id                    String        @id @default(cuid())
  organizacionId        String
  medicoId              String?
  rutEvaluado           String
  nombreEvaluado        String
  emailEvaluado         String?
  telefonoEvaluado      String?
  estado                EstadoCaso    @default(recibido)
  tipoLicencia          String
  fechaEmisionLicencia  DateTime
  fechaIngreso          DateTime
  fechaLimite           DateTime
  prioridad             PrioridadCaso @default(normal)
  creadoEn              DateTime      @default(now())
  actualizadoEn         DateTime      @updatedAt

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  medico       Usuario?     @relation("CasoMedico", fields: [medicoId], references: [id], onDelete: Restrict)
  sesion       Sesion?
  informe      Informe?
  logsEnvio    LogEnvio[]
  pagoMedico   PagoMedico?

  @@index([fechaLimite])
  @@index([organizacionId])
  @@index([estado])
}

model Sesion {
  id                       String       @id @default(cuid())
  casoId                   String       @unique
  fechaProgramada          DateTime
  dailyRoomUrl             String?
  estado                   EstadoSesion @default(agendada)
  consentimientoTimestamp  DateTime?
  grabacionUrl             String?
  medicoHoraConexion       DateTime?
  medicoHoraDesconexion    DateTime?
  evaluadoHoraConexion     DateTime?
  evaluadoHoraDesconexion  DateTime?
  duracionEfectivaSegundos Int?
  ameliaAppointmentId      Int?         @unique

  caso Caso @relation(fields: [casoId], references: [id], onDelete: Restrict)
}

model Informe {
  id                String         @id @default(cuid())
  casoId            String         @unique
  archivoUrl        String
  generadoEn        DateTime       @default(now())
  generadoPor       String
  firmaProveedor    FirmaProveedor?
  firmaTimestamp    DateTime?
  firmaDocumentoId  String?
  archivoFirmadoUrl String?

  caso      Caso          @relation(fields: [casoId], references: [id], onDelete: Restrict)
  medico    Usuario       @relation("InformeGeneradoPor", fields: [generadoPor], references: [id], onDelete: Restrict)
  descargas LogDescarga[]
}

model LogDescarga {
  id        String   @id @default(cuid())
  informeId String
  usuarioId String
  timestamp DateTime @default(now())

  informe Informe @relation(fields: [informeId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
}

model LogEnvio {
  id                    String      @id @default(cuid())
  canal                 CanalEnvio
  tipo                  String      // nombre de plantilla WA, o "manual" para email
  destino               String      // teléfono normalizado o email, desnormalizado
  destinatarioUsuarioId String?
  casoId                String?
  asunto                String?     // solo email
  cuerpo                String?     // solo email o texto libre WA
  estado                EstadoEnvio @default(enviado)
  error                 String?
  enviadoPorId          String
  creadoEn              DateTime    @default(now())

  destinatario Usuario? @relation("LogEnvioDestinatario", fields: [destinatarioUsuarioId], references: [id], onDelete: SetNull)
  caso         Caso?    @relation(fields: [casoId], references: [id], onDelete: SetNull)
  enviadoPor   Usuario  @relation("LogEnvioEnviadoPor", fields: [enviadoPorId], references: [id], onDelete: Restrict)

  @@index([casoId])
  @@index([destinatarioUsuarioId])
  @@index([creadoEn])
}

model PagoMedico {
  id        String     @id @default(cuid())
  medicoId  String
  casoId    String     @unique
  montoClp  Int
  estado    EstadoPago @default(pendiente)
  fechaPago DateTime?
  creadoEn  DateTime   @default(now())

  medico Usuario @relation(fields: [medicoId], references: [id], onDelete: Restrict)
  caso   Caso    @relation(fields: [casoId], references: [id], onDelete: Restrict)

  @@index([medicoId])
  @@index([estado])
}

model FacturaOrganizacion {
  id             String        @id @default(cuid())
  organizacionId String
  periodoInicio  DateTime
  periodoFin     DateTime
  casosIncluidos Int
  montoClp       Int
  estado         EstadoFactura @default(pendiente)
  creadoEn       DateTime      @default(now())
  facturadoEn    DateTime?

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict)

  @@index([organizacionId])
  @@index([estado])
}
